NODE_ENV=development
PORT=4000
# Use comma-separated origins when more than one frontend URL is allowed.
CORS_ORIGIN=http://localhost:5173

# Neon PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chess_arena

# Render Redis
REDIS_URL=redis://localhost:6379
# Use "redis" in Render or Docker. Keep "memory" for local work without Redis.
GAME_STORE_DRIVER=memory
# Active games expire after inactivity so abandoned rooms do not live forever.
ACTIVE_GAME_TTL_SECONDS=3600

LOG_LEVEL=info

# Gemini AI coaching
# Required in production to call Google's Gemini API. Local development returns a deterministic
# coaching fallback when this is blank so the UI and API can be smoke-tested safely.
GEMINI_API_KEY=
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
