# ==============================================================================
# Application
# ==============================================================================

# Determines the environment (development, test, production).
# In production, this disables stack traces and enables JSON structured logging.
NODE_ENV=development

# The port the Express API binds to.
PORT=4000

# Logging severity (fatal, error, warn, info, debug, trace).
LOG_LEVEL=info

# ==============================================================================
# Security
# ==============================================================================

# A comma-separated list of allowed origins for cross-origin requests.
# Must exactly match the frontend URL in production (no trailing slashes).
CORS_ORIGIN=http://localhost:5173

# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================

# The connection string for the Neon PostgreSQL database.
# Used by Drizzle ORM to persist completed games and history.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chess_arena

# ==============================================================================
# Redis (Pub/Sub & Caching)
# ==============================================================================

# The connection string for the Redis instance.
# Used for active game state and Socket.IO adapter broadcasting.
REDIS_URL=redis://localhost:6379

# The persistence driver for active gameplay state ('memory' or 'redis').
# Use 'redis' for production to allow horizontal scaling.
GAME_STORE_DRIVER=memory

# The time-to-live for an active game in seconds.
# Games older than this without updates are considered abandoned.
ACTIVE_GAME_TTL_SECONDS=3600

# ==============================================================================
# AI (Gemini)
# ==============================================================================

# Google Gemini API key for post-game coaching explanations.
# Leave blank to fallback to Stockfish-only development mode.
GEMINI_API_KEY=

# (Optional) Override the Gemini API endpoint for proxies or regional endpoints.
# GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# (Optional) The specific Gemini model to use for generation.
# GEMINI_MODEL=gemini-2.0-flash
