# ==============================================================================
# Application
# ==============================================================================

# The display name of the application, used in the navigation bar.
VITE_APP_NAME=Chess Arena

# ==============================================================================
# Network
# ==============================================================================

# The HTTP URL of the backend REST API.
# In production, this should point to your deployed Render service (e.g., https://my-app.onrender.com/api).
VITE_API_URL=http://localhost:4000/api

# The WebSocket URL for Socket.IO connections.
# In production, this should point to the root of your deployed Render service (e.g., https://my-app.onrender.com).
VITE_SOCKET_URL=http://localhost:4000
